{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/get/:path*",
      "destination": "https://yesofficer.studybeepro.site/get/:path*"
    },
    {
      "source": "/video",
      "destination": "https://yesofficer.studybeepro.site/video"
    },
    {
      "source": "/pdf",
      "destination": "https://yesofficer.studybeepro.site/pdf"
    },
    {
      "source": "/mpd",
      "destination": "https://yesofficer.studybeepro.site/mpd"
    },
    {
      "source": "/license-proxy",
      "destination": "https://yesofficer.studybeepro.site/license-proxy"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
